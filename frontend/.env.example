# Frontend Midnight Network Configuration
# Select target network mode: "local", "preview" (Level 4 Preview Baseline), or "preprod" (Level 5 Preprod Target)
VITE_MIDNIGHT_NETWORK="preprod"

# Deployed Smart Contract Address on Midnight Preprod (Leave empty until Preprod contract is deployed)
VITE_CONTRACT_ADDRESS=""
VITE_DEPLOY_TX_HASH=""

# Level 4 Preview Reference Contract Address
VITE_PREVIEW_CONTRACT_ADDRESS="9cbd81bf18cf2c5a208a9c4cdc5059b0aa220d05cf22e5edafe1c20abd7afb49"

# Midnight Preprod Network Service Endpoints
VITE_NODE_RPC_URL="https://rpc.preprod.midnight.network"
VITE_PROOF_SERVER_URL="https://proof-server.preprod.midnight.network"
VITE_INDEXER_URL="https://indexer.preprod.midnight.network/api/v3/graphql"

