# Frontend Midnight Network Configuration
# Select target network mode: "local" (standalone devnet) or "preview" (Midnight Preview Testnet)
VITE_MIDNIGHT_NETWORK="preview"

# Deployed Smart Contract Address on Midnight Preview (Leave empty before deployment)
VITE_CONTRACT_ADDRESS=""
VITE_DEPLOY_TX_HASH=""

# Midnight Network Service Endpoints
VITE_NODE_RPC_URL="https://rpc.preview.midnight.network"
VITE_PROOF_SERVER_URL="https://proof-server.preview.midnight.network"
VITE_INDEXER_URL="https://indexer.preview.midnight.network/api/v3/graphql"

