# Frontend Midnight Network Configuration
# Select target network mode: "local" (standalone devnet) or "preprod" (Midnight Preprod Testnet)
VITE_MIDNIGHT_NETWORK="preprod"

# Deployed Smart Contract Address on Midnight Preprod (Leave empty before deployment)
VITE_CONTRACT_ADDRESS=""

# Midnight Network Service Endpoints
VITE_NODE_RPC_URL="https://rpc.preprod.midnight.network"
VITE_PROOF_SERVER_URL="https://proof-server.preprod.midnight.network"
VITE_INDEXER_URL="https://indexer.preprod.midnight.network"
